{
    "name": "joelinit1/brand",
    "description": "jma.events and registration.space brand assets, synced into Laravel apps with php artisan brand:sync.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.1",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "JoelInit1\\Brand\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "JoelInit1\\Brand\\BrandServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
